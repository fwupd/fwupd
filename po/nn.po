#, c-format
msgid "Firmware metadata has not been updated for %u day and may not be up to date."
msgid_plural "Firmware metadata has not been updated for %u days and may not be up to date."
msgstr[0] "Fastvaremetadataa er ikkje oppdaterte på %u dag og er kanskje utdaterte."
msgstr[1] "Fastvaremetadataa er ikkje oppdaterte på %u dagar og er kanskje utdaterte."

#. TRANSLATORS: ask if we can update metadata
msgid "Update now?"
msgstr "Oppdatere no?"

#. TRANSLATORS: message letting the user know no device
#. * upgrade available due to missing on LVFS
#. TRANSLATORS: message letting the user know no
#. * device upgrade available due to missing on LVFS
