# -*- mode: dockerfile -*-
FROM {?PLATFORM-}--platform={{PLATFORM}} {-PLATFORM?}ubuntu:{{VERSION}}
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8
ENV CI_NETWORK=true
ENV DEBIAN_FRONTEND=noninteractive
ENV CC=clang
RUN echo fubar > /etc/machine-id
RUN set -euxo pipefail; \
    sed -i 's|Types: deb|Types: deb deb-src|' /etc/apt/sources.list.d/{{DISTRO}}.sources; \
    apt-get update -qq; \
    apt-get dist-upgrade -qq; \
    apt-get install -qq --yes --no-install-recommends software-properties-common; \
    add-apt-repository -y ppa:peter-hutterer/meson1.11; \
    apt-get install -qq --yes --no-install-recommends \
    meson \
    python3-apt \
    sudo \
{{DEPENDENCIES}}; \
    apt-get clean
{{RUSTUP}}
WORKDIR /github/workspace
