#!/usr/bin/env python3
# SPDX-License-Identifier: LGPL-2.1-or-later
#
# Wrapper script for fub.
#
# This script is intended to be called from the repository root directory, e.g.
# $ ./fub init
# $ ./fub build
#
# Once set up it will detect a virtual env and use its Python interpreter.

from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path


def main() -> int:
    # Inject contrib/ into sys.path so `from fub.cli import main` works
    contrib_dir = Path(__file__).resolve().parent / "contrib"
    if str(contrib_dir) not in sys.path:
        sys.path.insert(0, str(contrib_dir))

    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("-C", dest="directory", default=None)
    args, remaining = parser.parse_known_args()

    if args.directory:
        resolved = Path(args.directory).resolve()
        virtual_env = os.environ.get("VIRTUAL_ENV")
        if virtual_env and Path(virtual_env).resolve() != resolved:
            print(
                f"{args.directory} must match current virtualenv, run 'deactivate' to drop the virtualenv"
            )
            return 1
        venv_dir = resolved
    elif os.environ.get("VIRTUAL_ENV"):
        venv_dir = Path(os.environ["VIRTUAL_ENV"])
    else:
        # Discover the most recent stamped venv
        marker_file = "this-is-a-fwupd-build-root"
        latest_mtime = 0.0
        venv_dir = None
        for marker in Path.cwd().rglob(marker_file):
            if marker.stat().st_mtime > latest_mtime:
                latest_mtime = marker.stat().st_mtime
                venv_dir = marker.parent

    if venv_dir is not None:
        python_path = venv_dir / "bin" / "python3"
        if python_path.exists():
            # Running under this python already — just ensure bin is on PATH
            bin_dir = venv_dir / "bin"
            if str(bin_dir) not in os.environ.get("PATH", ""):
                os.environ["PATH"] = f"{bin_dir}{os.pathsep}{os.environ['PATH']}"

    from fub.cli import main as cli_main

    sys.argv = ["fub"] + remaining
    return cli_main()


if __name__ == "__main__":
    sys.exit(main())
