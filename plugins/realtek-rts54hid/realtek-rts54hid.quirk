# Realtek USBHub (HID Device)
[USB\VID_0BDA&PID_5A00]
Plugin = realtek_rts54hid
Flags = enforce-requires
GType = FuRealtekRts54hidHubDevice
Rts54HidType = hub
FirmwareSizeMin = 0x10000
FirmwareSizeMax = 0x40000
Children = FuRealtekRts54hidModule|USB\VID_0BDA&PID_5A00&I2C_01

# this is a fictitious example...
[USB\VID_0BDA&PID_5A00&I2C_01]
Plugin = realtek_rts54hid
Name = HDMI Converter
Flags = updatable
FirmwareSize = 0x20000
Rts54TargetAddr = 0x00
Rts54I2cSpeed = 0x00
Rts54RegisterAddrLen = 0x04

# Lenove CMB
[USB\VID_0BDA&PID_1299]
Plugin = realtek_rts54hid
GType = FuRealtekRts54hidPdDevice
Flags = ~reset-after-update
Name = Realtek CMB PD
FirmwareSizeMin = 0x10000
FirmwareSizeMax = 0x20000
