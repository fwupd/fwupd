# Lenovo ThinkSystem
[42f00735-c9ab-5374-bd63-a5deee5881e0]
Flags = wildcard-targets,reset-required,ipmi-create-user

[REDFISH\VENDOR_Lenovo&ID_BMC-Backup]
ParentGuid = REDFISH\VENDOR_Lenovo&ID_BMC-Primary
Flags = dual-image,is-backup,no-probe

[REDFISH\VENDOR_Lenovo&ID_BMC-Primary]
Flags = dual-image,manager-reset
RedfishResetPreDelay = 10000
RedfishResetPostDelay = 40000

[REDFISH\VENDOR_Lenovo&ID_LXPM]
Flags = ~updatable
[REDFISH\VENDOR_Lenovo&ID_LXPMLinuxDriver]
Flags = ~updatable
ParentGuid = REDFISH\VENDOR_Lenovo&ID_LXPM
[REDFISH\VENDOR_Lenovo&ID_LXPMWindowsDriver]
Flags = ~updatable
ParentGuid = REDFISH\VENDOR_Lenovo&ID_LXPM

[REDFISH\VENDOR_SMCI&ID_Backup_BIOS]
Flags = is-backup,no-probe

# Advantech
[18789130-a714-53c0-b025-fa93801d3995]
Flags = wildcard-targets,ipmi-create-user

[REDFISH\VENDOR_Advantech&ID_BMC]
Flags = manager-reset,no-manager-reset-request
RedfishResetPreDelay = 100000

[REDFISH\VENDOR_Dell&SOFTWAREID_25227]
Flags = manager-reset,no-manager-reset-request
RedfishResetPreDelay = 120000

# A system is a DGX Station GB300 when its SMBIOS product name contains every
# |-separated token, in any order and case. The manufacturer is not checked, as
# OEM-built stations report their own brand.
[REDFISH\NVIDIA_OOB_PRODUCT]
RedfishProductNameTokens = GB300|Station

# DGX Station GB300 sold by an OEM: the section is the SMBIOS system manufacturer
# and RedfishOemVendorIds the |-separated vendor IDs of that OEM's LVFS account,
# so only that account's firmware is offered. A manufacturer with no section here
# gets vendor IDs built from its own name.
[DMI\MANUFACTURER_NVIDIA]
RedfishOemVendorIds = REDFISH:NVIDIA|DMI:NVIDIA|OEM:NVIDIA

[DMI\MANUFACTURER_Dell Inc.]
RedfishOemVendorIds = REDFISH:DELL|DMI:Dell Inc.|OEM:Dell Inc.

[DMI\MANUFACTURER_Super Micro Computer, Inc.]
RedfishOemVendorIds = REDFISH:SMCI|DMI:Super Micro Computer, Inc.|OEM:Super Micro Computer, Inc.

[DMI\MANUFACTURER_Supermicro]
RedfishOemVendorIds = REDFISH:SMCI|DMI:Supermicro|OEM:Supermicro

[DMI\MANUFACTURER_HP]
RedfishOemVendorIds = REDFISH:HP|DMI:HP|OEM:HP

[DMI\MANUFACTURER_HPE]
RedfishOemVendorIds = REDFISH:HPE|DMI:HPE|OEM:HPE

[DMI\MANUFACTURER_Hewlett Packard Enterprise]
RedfishOemVendorIds = REDFISH:HPE|DMI:Hewlett Packard Enterprise|OEM:Hewlett Packard Enterprise

[DMI\MANUFACTURER_ASUSTeK COMPUTER INC.]
RedfishOemVendorIds = REDFISH:ASUS|DMI:ASUSTeK COMPUTER INC.|OEM:ASUSTeK COMPUTER INC.

[DMI\MANUFACTURER_GIGABYTE]
RedfishOemVendorIds = REDFISH:GIGABYTE|DMI:GIGABYTE|OEM:GIGABYTE

[DMI\MANUFACTURER_Giga Computing]
RedfishOemVendorIds = REDFISH:GIGABYTE|DMI:Giga Computing|OEM:Giga Computing

[DMI\MANUFACTURER_Micro-Star International Co., Ltd.]
RedfishOemVendorIds = REDFISH:MSI|DMI:Micro-Star International Co., Ltd.|OEM:Micro-Star International Co., Ltd.
